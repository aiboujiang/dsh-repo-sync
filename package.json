{
  "name": "dsh-repo-sync",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "把工作区里的插件仓库定时提交并推送到 git，带冲突检测与安全闸",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "git",
    "sync",
    "backup"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiboujiang/dsh-repo-sync.git"
  },
  "homepage": "https://github.com/aiboujiang/dsh-repo-sync#readme",
  "bugs": {
    "url": "https://github.com/aiboujiang/dsh-repo-sync/issues"
  },
  "author": "aiboujiang"
}
